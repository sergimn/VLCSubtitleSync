{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Europe/Madrid",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "pre-commit": { "enabled": true },
  "packageRules": [
    {
      "description": "CI tooling and dev-only dependencies: group and automerge when CI passes",
      "matchManagers": ["github-actions", "pre-commit"],
      "groupName": "CI tooling",
      "automerge": true
    },
    {
      "description": "Dev extras (pytest, ruff, lupa, piper-tts) are low risk",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.optional-dependencies"],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "description": "Runtime deps affect users: never automerge, one PR per package",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies"],
      "automerge": false
    }
  ]
}
